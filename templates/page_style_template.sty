% templates/page_style_template.sty
\ProvidesPackage{page_style}[2026/07/06 Imprint Image+Text Page Style]

\RequirePackage{fontspec}
% xeCJK breaks a line between ANY two CJK characters by default, including inside a single Korean
% word (어절) -- e.g. "대담한" could split into "대담" / "한" across two lines. That's normal/expected
% for Chinese/Japanese (no word concept at the character level) but wrong for Korean, which only
% breaks at spaces between 어절. kotex (loading xetexko under XeTeX) implements Korean-specific
% line-breaking that only breaks at 어절 boundaries, never inside one -- confirmed via a real
% side-by-side XeLaTeX compile 2026-07-27 (plain xeCJK: "제품에 대담" / "한 색상과..." split
% mid-word; kotex: "대담한 색상과..." stays whole, only wraps at the next space). Only the raggedright
% (unjustified) case matters for this project (all body text is raggedright), and kotex's own
% ragged-right handling never needs to fill lines by hyphenating, so no separate justify/ragged
% branching is needed here -- \NoHyphenRaggedRight below still applies unconditionally.
\RequirePackage{kotex}
\RequirePackage{geometry}
\RequirePackage[absolute,overlay]{textpos}
\RequirePackage{graphicx}
% cover-crop 이미지: 그리드 칸을 비율 유지로 꽉 채우고 넘치는 부분을 \clipbox로 잘라낸다
% (buildLatex.js의 image.cover 분기). trimclip은 texlive에 포함된 adjustbox 번들의 일부.
\RequirePackage{trimclip}
\RequirePackage[none]{hyphenat}

% 전역 문단 들여쓰기 및 간격 제거 (textblock 정렬 보장)
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

% 왼쪽 정렬(\raggedright)에서는 단어를 늘려 채울 필요가 없으므로, 굳이 단어를 하이픈으로 잘라
% 다음 줄로 넘길 이유가 없다 -- 오히려 편집 가독성을 해친다(단어가 끊겨 보임). 하이픈 분리를
% 사실상 비활성화하여 항상 단어 전체가 다음 줄로 넘어가도록 한다.
\hyphenpenalty=10000
\exhyphenpenalty=10000
\lefthyphenmin=64
\righthyphenmin=64

\geometry{
  paperwidth={{PAGE_WIDTH}}mm,
  paperheight={{PAGE_HEIGHT}}mm,
  top={{MARGIN_TOP}}mm,
  bottom={{MARGIN_BOTTOM}}mm,
  inner={{MARGIN_INNER}}mm,
  outer={{MARGIN_OUTER}}mm,
}
\setlength{\TPHorizModule}{1mm}
\setlength{\TPVertModule}{1mm}

% 본문 세리프: PRD 지정 Noto Serif KR은 이 PC에 정적 폰트가 없어(가변폰트만 존재,
% xdvipdfmx 임베드 실패 이력) IBM Plex Serif로 대체한다.
% 주의: {{{FONTS_DIR}}/} 처럼 중괄호가 3~4개 겹쳐 보이는 곳은 LaTeX 문법용 리터럴 중괄호 1개와
% 이중 중괄호로 감싼 치환 토큰(중괄호 2개)이 겹쳐진 것이다 — 치환 후에는 { .../ } 형태의 정상적인
% LaTeX 그룹 하나가 된다. 폰트 파라미터를 추가/수정할 때 중괄호 개수를 세어보고 맞출 것.
\setmainfont{{{BODY_FONT_FILE_EN}}}[
  Path = {{{FONTS_DIR}}/}, Extension = .{{BODY_FONT_FILE_EXT}}, BoldFont = {{{BODY_FONT_FILE_BOLD}}},
]
\setmainhangulfont{{{BODY_FONT_FILE_KR}}}[
  Path = {{{FONTS_DIR}}/}, Extension = .{{BODY_FONT_FILE_EXT}}, BoldFont = {{{BODY_FONT_FILE_KR_BOLD}}},
]

% Body roles are set ragged-right (not fully justified). Narrow columns mixing CJK (which has no
% inter-word spaces to stretch) with occasional Latin words/brand names produce large, uneven gaps
% under full justification because TeX has only a handful of justifiable spaces per line to work
% with. Ragged-right avoids that stretching entirely; line-break quality is otherwise unaffected.
\newcommand{\NoHyphenRaggedRight}{\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000\lefthyphenmin=64\righthyphenmin=64}
\newcommand{\BodyText}[1]{\fontsize{{{BODY_FONT_SIZE}}pt}{{{BODY_LEADING}}pt}\selectfont\NoHyphenRaggedRight #1\par}

% Role-based text styles for modular paragraph layouts
% Enables different visual emphasis for section titles, case studies, body text, and credits
% Leading (2nd \fontsize argument) kept at >=1.25x the font size for every bold heading role --
% confirmed 2026-07-27: SectionTitleText's old 14pt/16pt (1.14x) and CaseTitle*'s old ~1.18-1.2x
% read as visibly cramped once a heading needs more than one line (bold CJK glyphs are visually
% denser than regular-weight body text, so headings need MORE headroom than body text's 1.56x
% ratio, not less). Bumped to a consistent >=1.25x floor across every heading-style role.
\newcommand{\SectionTitleText}[1]{\fontsize{14pt}{18pt}\selectfont\bfseries\NoHyphenRaggedRight #1\par}
\newcommand{\CaseTitleKoText}[1]{\fontsize{11pt}{14pt}\selectfont\bfseries\NoHyphenRaggedRight #1\par}
\newcommand{\CaseTitleEnText}[1]{\fontsize{10pt}{13pt}\selectfont\bfseries\NoHyphenRaggedRight\MakeUppercase{#1}\par}
\newcommand{\CaseBodyText}[1]{\fontsize{{{BODY_FONT_SIZE}}pt}{{{BODY_LEADING}}pt}\selectfont\NoHyphenRaggedRight #1\par}
\newcommand{\CreditText}[1]{\fontsize{7pt}{9pt}\selectfont\itshape #1\par}
\newcommand{\PageNumberText}[1]{\fontsize{9pt}{11pt}\selectfont #1}
\newcommand{\RunningHeadText}[1]{\fontsize{8pt}{10pt}\selectfont #1}

% 제목(섹션 오프너) 전용 서체: PRD 4.5의 제목/구조용 산세리프인 Noto Sans KR을
% 본문 세리프(IBM Plex Serif)와는 별도의 폰트 패밀리로 선언한다.
\newfontfamily\HeadingENFace{{{HEADING_FONT_FILE_EN}}}[
  Path = {{{FONTS_DIR}}/}, Extension = .{{HEADING_FONT_FILE_EXT}}, BoldFont = {{{HEADING_FONT_FILE_BOLD}}},
]
\newhangulfontfamily\HeadingKRFace{{{HEADING_FONT_FILE_KR}}}[
  Path = {{{FONTS_DIR}}/}, Extension = .{{HEADING_FONT_FILE_EXT}}, BoldFont = {{{HEADING_FONT_FILE_KR_BOLD}}},
]
\newcommand{\HeadingFontSet}{\HeadingENFace\HeadingKRFace}
\newcommand{\TitleText}[1]{{\HeadingFontSet\bfseries\fontsize{{{TITLE_FONT_SIZE}}pt}{{{TITLE_LEADING}}pt}\selectfont\NoHyphenRaggedRight #1\par}}

\pagestyle{empty}
\endinput
